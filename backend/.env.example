PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airclean_db
DB_USER=postgres
DB_PASS=yourpassword
JWT_SECRET=your_jwt_secret_here
UPLOAD_DIR=uploads

# ── AC repair ↔ repair-system integration ───────────────────
# Inbound auto-import webhook: repair-system POSTs here when an AC job is assigned.
# Must match repair-system's AIR_WEBHOOK_SECRET. Empty = webhook rejects all (off).
AIR_WEBHOOK_SECRET=
# Manual "นำเข้างาน" button reads repair-system's pending AC jobs (optional — auto-
# import covers the main flow). Per-branch hospital mapping is clients.repair_slug.
REPAIR_API_URL=https://pypl-engineering.online
REPAIR_SERVICE_KEY=

# ── Seed / Excel import (เฟส 0) ──────────────────────────────
# path ไป ac-data-clean.xlsx ที่ seed script อ่าน (3 ชีต: แอร์/พัดลม/รหัสซ้ำ)
EXCEL_PATH=./data/ac-data-clean.xlsx
# พัดลมในไฟล์ยังไม่มี client/site → import ผูกค่าเริ่มต้นนี้ + flag needs_recode ให้ตรวจ site รายตัวภายหลัง
FAN_DEFAULT_CLIENT_CODE=PTS1
FAN_DEFAULT_SITE_NAME=โรงพยาบาลพญาไท ศรีราชา 1
