# Environment for the Excel import scripts (import_pts_excel.py, backend/src/db/import_excel.py)
# Copy to .env and fill real values. NEVER commit the real .env.

# PostgreSQL connection
DB_HOST=
DB_PORT=5432
DB_NAME=airclean_db
DB_USER=
DB_PASS=

# Absolute path to the source Excel workbook
EXCEL_PATH=

# Hospital slug used by backend/src/db/import_excel.py
HOSPITAL_SLUG=pts1
